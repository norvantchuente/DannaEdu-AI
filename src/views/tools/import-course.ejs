<!DOCTYPE html>
<html lang="<%= user && user.language === 'Anglais' ? 'en' : (user && user.language === 'Espagnol' ? 'es' : 'en') %>">
<head>
    <meta charset="UTF-8">
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col font-sans">
    <header class="bg-white border-b border-slate-200 p-4 shadow-sm">
        <div class="container mx-auto flex justify-between items-center">
            <h1 class="text-xl font-bold">DannaEdu <span class="text-indigo-600">AI</span> - Import Course</h1>
            <a href="/dashboard" class="text-xs text-indigo-600 font-semibold hover:underline">← Back to Dashboard</a>
        </div>
    </header>

    <main class="container mx-auto p-6 max-w-2xl flex-grow space-y-6">
        <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm space-y-4">
            <h2 class="text-base font-bold text-slate-900">📂 Upload an Educational Document</h2>
            <p class="text-xs text-slate-500">Accepted formats: <strong>.pdf, .docx, .txt, .json</strong>. The intelligent extraction engine will process the content to integrate it into your space.</p>

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="bg-red-50 border border-red-200 text-red-600 p-3 rounded-xl text-xs"><%= error %></div>
            <% } %>

            <form action="/courses/import" method="POST" enctype="multipart/form-data" class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">Course Title</label>
                    <input type="text" name="title" required placeholder="Ex: Introduction to Neural Networks" class="w-full border border-slate-200 rounded-xl p-2.5 text-xs focus:ring-2 focus:ring-indigo-500 focus:outline-none">
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">Course File (.pdf, .docx, .txt, .json)</label>
                    <input type="file" name="courseFile" accept=".pdf,.docx,.doc,.txt,.json" required class="w-full border border-slate-200 rounded-xl p-2 text-xs file:mr-4 file:py-1 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-indigo-600 file:text-white hover:file:bg-indigo-500">
                </div>

                <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-500 text-white font-medium py-2.5 rounded-xl text-xs transition shadow-md">Analyze and Import Course</button>
            </form>
        </div>

        <% if (typeof importedCourse !== 'undefined' && importedCourse) { %>
            <div class="bg-emerald-50 border border-emerald-200 rounded-2xl p-6 space-y-3">
                <h3 class="font-bold text-sm text-emerald-900">✨ Course imported successfully!</h3>
                <p class="text-xs font-semibold text-emerald-800">Title: <%= importedCourse.title %></p>
                <div class="bg-white border border-emerald-200 rounded-xl p-4 max-h-40 overflow-y-auto text-xs text-slate-600 whitespace-pre-wrap"><%= importedCourse.content %></div>
                <a href="/dashboard" class="inline-block bg-emerald-600 text-white font-semibold px-4 py-2 rounded-xl text-xs">Return to Dashboard</a>
            </div>
        <% } %>
    </main>
</body>
</html>