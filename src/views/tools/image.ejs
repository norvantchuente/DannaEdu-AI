<!DOCTYPE html>
<html lang="<%= user.language === 'Anglais' ? 'en' : (user.language === 'Espagnol' ? 'es' : 'en') %>">
<head>
    <meta charset="UTF-8">
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-white text-slate-800 min-h-screen flex flex-col font-sans">
    <header class="bg-white border-b border-slate-200 p-4 sticky top-0 z-50 shadow-sm">
        <div class="container mx-auto flex justify-between items-center">
            <a href="/dashboard" class="bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs px-3 py-1.5 rounded-xl transition font-medium">← Dashboard</a>
            <h1 class="text-base font-bold text-slate-900">🎨 Visual Illustrations & Editing</h1>
        </div>
    </header>

    <main class="container mx-auto p-6 flex-grow grid grid-cols-1 md:grid-cols-2 gap-6">
        
        <!-- Left Column: Generation and Editing Forms -->
        <div class="space-y-6">
            
            <!-- Section 1: Generation -->
            <div class="bg-slate-50 border border-slate-200 rounded-2xl p-6 shadow-sm space-y-4">
                <div class="bg-emerald-50 border border-emerald-100 p-3 rounded-xl text-xs text-emerald-700">
                    ℹ️ <strong>Generation:</strong> Create minimalist vector diagrams and educational illustrations from a text description.
                </div>

                <form action="/tools/image/generate" method="POST" class="space-y-3">
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Description (Prompt):</label>
                        <input type="text" name="promptDesc" required placeholder="Ex: A clean vector diagram of a plant cell..." class="w-full bg-white border border-slate-200 rounded-xl p-3 text-xs text-slate-900 focus:ring-2 focus:ring-emerald-500 shadow-xs">
                    </div>
                    <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-500 text-white font-medium py-2.5 rounded-xl text-xs transition shadow-md">Generate Illustration</button>
                </form>
            </div>

            <!-- Section 2: Editing / Modification -->
            <div class="bg-slate-50 border border-slate-200 rounded-2xl p-6 shadow-sm space-y-4">
                <div class="bg-indigo-50 border border-indigo-100 p-3 rounded-xl text-xs text-indigo-700">
                    ℹ️ <strong>Editing / Modification:</strong> Upload an existing image and specify the changes to apply.
                </div>

                <form action="/tools/image/edit" method="POST" enctype="multipart/form-data" class="space-y-3">
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Source image to edit (.png, .jpg):</label>
                        <input type="file" name="sourceImage" accept="image/*" required class="w-full bg-white border border-slate-200 rounded-xl p-2.5 text-xs text-slate-600 file:mr-4 file:py-1 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-indigo-600 file:text-white hover:file:bg-indigo-500 shadow-xs">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Modification Instructions:</label>
                        <input type="text" name="editPrompt" required placeholder="Ex: Add a glowing arrow pointing to the core..." class="w-full bg-white border border-slate-200 rounded-xl p-3 text-xs text-slate-900 focus:ring-2 focus:ring-emerald-500 shadow-xs">
                    </div>
                    <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-500 text-white font-medium py-2.5 rounded-xl text-xs transition shadow-md">Edit Image</button>
                </form>
            </div>

        </div>

        <!-- Right Column: Preview, Zoom & Download -->
        <div class="bg-slate-50 border border-slate-200 rounded-2xl p-6 shadow-sm flex flex-col items-center justify-center">
            <h3 class="text-xs font-bold uppercase tracking-wider text-slate-700 mb-4 self-start">Preview & Result:</h3>
            <% if (imageUrl) { %>
                <div class="space-y-4 text-center w-full">
                    <!-- Clickable image to zoom -->
                    <div class="relative group cursor-pointer inline-block" onclick="openModal('<%= imageUrl %>')">
                        <img src="<%= imageUrl %>" alt="Generated or edited illustration" class="rounded-xl max-h-72 object-contain border border-slate-200 bg-white p-2 shadow-xs transition group-hover:opacity-90 mx-auto">
                        <div class="absolute inset-0 flex items-center justify-center bg-black/40 opacity-0 group-hover:opacity-100 transition rounded-xl text-white text-xs font-semibold gap-1.5 px-3 py-1">
                            <span>🔍</span> Click to zoom
                        </div>
                    </div>

                    <!-- Action buttons (Zoom & Download) -->
                    <div class="flex justify-center gap-3 pt-2">
                        <button onclick="openModal('<%= imageUrl %>')" class="bg-slate-200 hover:bg-slate-300 text-slate-800 text-xs font-semibold px-4 py-2.5 rounded-xl transition shadow-xs flex items-center gap-1.5">
                            <span>🔍</span> Zoom
                        </button>
                        <a href="<%= imageUrl %>" download="illustration_dannaedu.png" target="_blank" class="bg-slate-900 hover:bg-slate-800 text-white text-xs font-semibold px-4 py-2.5 rounded-xl transition shadow-sm flex items-center gap-1.5">
                            <span>📥</span> Download
                        </a>
                    </div>
                </div>
            <% } else { %>
                <p class="text-xs text-slate-400 text-center py-12">The generated or edited illustration will appear here.</p>
            <% } %>
        </div>

    </main>

    <!-- Zoom Modal (Lightbox) -->
    <div id="imageModal" class="fixed inset-0 bg-black/80 z-50 hidden flex items-center justify-center p-4 cursor-pointer backdrop-blur-xs" onclick="closeModal()">
        <div class="relative max-w-5xl max-h-[90vh] bg-white rounded-2xl p-4 shadow-2xl flex flex-col items-center" onclick="event.stopPropagation()">
            <button onclick="closeModal()" class="absolute top-3 right-3 text-slate-500 hover:text-slate-900 text-lg font-bold bg-slate-100 hover:bg-slate-200 w-8 h-8 rounded-full flex items-center justify-center transition">&times;</button>
            <img id="modalImg" src="" alt="Zoomed view" class="max-h-[80vh] max-w-full rounded-xl object-contain mt-4">
            <div class="mt-4 flex gap-3">
                <a id="modalDownloadBtn" href="" download="illustration_dannaedu.png" target="_blank" class="bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-semibold px-5 py-2.5 rounded-xl transition shadow-md flex items-center gap-1.5">
                    <span>📥</span> Download from preview
                </a>
                <button onclick="closeModal()" class="bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold px-5 py-2.5 rounded-xl transition">Close</button>
            </div>
        </div>
    </div>

    <!-- Modal JavaScript -->
    <script>
        function openModal(imgSrc) {
            document.getElementById('modalImg').src = imgSrc;
            document.getElementById('modalDownloadBtn').href = imgSrc;
            document.getElementById('imageModal').classList.remove('hidden');
        }
        function closeModal() {
            document.getElementById('imageModal').classList.add('hidden');
        }
    </script>
</body>
</html>