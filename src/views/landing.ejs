<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-white text-slate-800 min-h-screen flex flex-col justify-between selection:bg-indigo-500 selection:text-white">

    <!-- Header Navigation -->
    <header class="border-b border-slate-100 bg-white/80 backdrop-blur sticky top-0 z-50">
        <div class="container mx-auto px-6 h-20 flex justify-between items-center">
            <div class="flex items-center space-x-3">
                <div class="bg-indigo-600 text-white font-black px-3 py-2 rounded-xl shadow-lg text-sm">DE</div>
                <span class="text-lg font-bold tracking-tight text-slate-900">DannaEdu <span class="text-indigo-600">AI</span></span>
            </div>
            <div class="flex items-center space-x-3">
                <a href="/login" class="text-xs font-medium text-slate-600 hover:text-slate-900 px-4 py-2 transition">Login</a>
                <a href="/register" class="bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-semibold px-4 py-2.5 rounded-xl transition shadow-lg shadow-indigo-600/20">Get Started</a>
            </div>
        </div>
    </header>

    <!-- Hero Section -->
    <main class="container mx-auto px-6 py-16 flex-grow flex flex-col items-center text-center justify-center space-y-8">
        <div class="inline-flex items-center space-x-2 bg-indigo-50 border border-indigo-100 px-3 py-1.5 rounded-full text-indigo-600 text-xs font-semibold">
            <span class="w-2 h-2 rounded-full bg-indigo-600 animate-pulse"></span>
            <span>Advanced AI-Powered Learning & Media Segmentation</span>
        </div>

        <h1 class="text-4xl md:text-6xl font-black tracking-tight max-w-4xl leading-tight text-slate-900">
            Learn without borders in your <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 to-violet-600">own language</span>.
        </h1>

        <p class="text-slate-600 text-sm md:text-base max-w-2xl leading-relaxed">
            DannaEdu AI dynamically adapts courses, generates interactive illustrations, transcribes audio lessons, and features advanced object segmentation and tracking across images and videos in 25 natively supported languages.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 w-full justify-center pt-4">
            <a href="/register" class="bg-indigo-600 hover:bg-indigo-500 text-white font-semibold px-8 py-3.5 rounded-xl text-sm transition shadow-xl shadow-indigo-600/20">Create Free Account</a>
            <a href="/login" class="bg-slate-50 hover:bg-slate-100 border border-slate-200 text-slate-700 font-semibold px-8 py-3.5 rounded-xl text-sm transition">Access Portal</a>
        </div>

        <!-- 25 Languages Badge Grid -->
        <div class="pt-12 w-full max-w-4xl">
            <p class="text-xs uppercase tracking-wider text-slate-400 font-semibold mb-6">Compatible with 25 major global languages</p>
            <div class="flex flex-wrap justify-center gap-2">
                <% ['French', 'English', 'Arabic', 'Spanish', 'German', 'Mandarin', 'Japanese', 'Korean', 'Hindi', 'Portuguese', 'Italian', 'Dutch', 'Turkish', 'Vietnamese', '+ 11 others'].forEach(lang => { %>
                    <span class="bg-slate-50 border border-slate-200 text-slate-600 text-[11px] px-3 py-1 rounded-lg"><%= lang %></span>
                <% }) %>
            </div>
        </div>
    </main>

    <!-- Footer -->
    <footer class="border-t border-slate-100 py-8 text-center text-xs text-slate-400">
        DannaEdu AI – World-Class Inclusive and Multilingual Education &copy; 2026
    </footer>

</body>
</html>