<!DOCTYPE html>
<html lang="<%= user.language === 'Anglais' ? 'en' : (user.language === 'Espagnol' ? 'es' : 'en') %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-white text-slate-800 min-h-screen flex flex-col font-sans">

    <!-- Header -->
    <header class="bg-white border-b border-slate-200 p-4 sticky top-0 z-50 shadow-sm">
        <div class="container mx-auto flex justify-between items-center">
            <div class="flex items-center space-x-3">
                <a href="/dashboard" class="bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs px-3 py-1.5 rounded-xl transition font-medium">← Dashboard</a>
                <h1 class="text-base font-bold tracking-tight text-slate-900">Adaptive Quiz</h1>
            </div>
            <div class="text-xs text-indigo-600 font-semibold"><%= user.level %> • <%= user.language %></div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="container mx-auto p-6 flex-grow flex items-center justify-center">
        <div class="w-full max-w-2xl bg-slate-50 border border-slate-200 rounded-2xl p-8 shadow-sm space-y-6">
            
            <!-- Quiz Header -->
            <div class="space-y-2">
                <span class="bg-indigo-50 text-indigo-600 text-xs font-semibold px-3 py-1 rounded-full border border-indigo-100">Interactive Assessment</span>
                <h2 class="text-xl font-black text-slate-900 mt-2"><%= quiz.question %></h2>
            </div>

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="p-3 bg-red-50 border border-red-200 text-red-600 rounded-xl text-xs font-medium"><%= error %></div>
            <% } %>

            <!-- Answer Form -->
            <% if (!evaluation) { %>
                <form action="/quiz/<%= quiz.id %>/submit" method="POST" class="space-y-4">
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-2">Your Answer:</label>
                        <input type="text" name="userAnswer" required placeholder="Type your answer here..." class="w-full bg-white border border-slate-200 rounded-xl p-3.5 text-sm text-slate-900 focus:ring-2 focus:ring-indigo-500 focus:outline-none shadow-xs">
                    </div>
                    <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-500 text-white font-medium py-3 rounded-xl text-sm transition shadow-md shadow-indigo-600/20">Submit Answer</button>
                </form>
            <% } else { %>
                <!-- Evaluation & AI Feedback -->
                <div class="space-y-4 pt-4 border-t border-slate-200">
                    <div class="bg-white border border-slate-200 rounded-xl p-4 text-xs space-y-2 shadow-xs">
                        <p class="text-slate-600">Your Answer: <strong class="text-slate-900"><%= userAnswer %></strong></p>
                    </div>

                    <div class="bg-indigo-50 border border-indigo-200 rounded-xl p-5 space-y-2">
                        <h3 class="text-xs font-bold uppercase tracking-wider text-indigo-600 flex items-center gap-2">
                            <span>✨</span> Correction & Feedback (<%= user.level %>)
                        </h3>
                        <div class="text-sm text-slate-700 leading-relaxed whitespace-pre-wrap"><%= evaluation %></div>
                    </div>

                    <div class="flex gap-3 pt-2">
                        <a href="/quiz/<%= quiz.id %>" class="flex-grow bg-white hover:bg-slate-100 border border-slate-200 text-slate-700 text-center py-3 rounded-xl text-xs font-semibold transition shadow-xs">Try Again</a>
                        <a href="/dashboard" class="flex-grow bg-indigo-600 hover:bg-indigo-500 text-white text-center py-3 rounded-xl text-xs font-semibold transition shadow-md shadow-indigo-600/20">Back to Dashboard</a>
                    </div>
                </div>
            <% } %>

        </div>
    </main>

    <!-- Footer -->
    <footer class="bg-white border-t border-slate-200 p-4 text-center text-xs text-slate-400">
        DannaEdu AI – Adaptive Assessment &copy; 2026
    </footer>

</body>
</html>