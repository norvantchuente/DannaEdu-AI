<!DOCTYPE html>
<html lang="<%= user && user.language === 'Anglais' ? 'en' : (user && user.language === 'Espagnol' ? 'es' : 'en') %>">
<head>
    <meta charset="UTF-8">
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col font-sans">
    <header class="bg-white border-b border-slate-200 p-4 sticky top-0 z-50 shadow-sm">
        <div class="container mx-auto flex justify-between items-center">
            <h1 class="text-xl font-bold">DannaEdu <span class="text-indigo-600">AI</span> - Course Consultation & Tutor</h1>
            <a href="/dashboard" class="text-xs text-indigo-600 font-semibold hover:underline">← Back to Dashboard</a>
        </div>
    </header>

    <main class="container mx-auto p-6 max-w-4xl flex-grow space-y-6">
        <!-- Course Header -->
        <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm space-y-4">
            <div class="flex justify-between items-start">
                <span class="bg-indigo-50 text-indigo-600 text-xs font-semibold px-3 py-1 rounded-full"><%= course.level || 'All levels' %></span>
                <span class="text-xs text-slate-400">Language: <%= course.target_language %></span>
            </div>
            <h2 class="text-2xl font-black text-slate-900"><%= course.title %></h2>
            <p class="text-sm text-slate-600"><%= course.description %></p>
        </div>

        <!-- Action Buttons (Back & Delete) -->
        <div class="flex justify-between items-center pt-4 border-t border-slate-200">
            <a href="/dashboard" class="bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold px-4 py-2 rounded-xl text-xs transition">← Back to Dashboard</a>
            
            <form action="/courses/view/<%= course.id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to permanently delete this course?');">
                <button type="submit" class="bg-red-50 hover:bg-red-100 text-red-600 border border-red-200 font-semibold px-4 py-2 rounded-xl text-xs transition">🗑️ Delete this course</button>
            </form>
        </div>

        <!-- Course Content -->
        <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm space-y-4">
            <h3 class="font-bold text-base text-slate-900">📖 Course Content</h3>
            <div class="bg-slate-50 border border-slate-200 rounded-xl p-6 text-sm text-slate-700 whitespace-pre-wrap leading-relaxed max-h-96 overflow-y-auto"><%= course.content %></div>
        </div>

        <!-- Chat / AI Tutor Section -->
        <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm space-y-4">
            <h3 class="font-bold text-base text-slate-900">💬 Ask Danna AI (AI Tutor)</h3>
            <div id="chat-box" class="bg-slate-50 border border-slate-200 rounded-xl p-4 h-64 overflow-y-auto space-y-3 text-xs flex flex-col">
                <div class="bg-indigo-50 text-indigo-900 p-3 rounded-xl self-start max-w-[80%] border border-indigo-100">
                    Hello! I am your AI tutor. Ask me any questions about this course, and I will help you understand it.
                </div>
            </div>

            <form id="chat-form" class="flex gap-2">
                <input type="text" id="chat-input" placeholder="Ex: Summarize the main section for me..." required class="flex-grow border border-slate-200 rounded-xl p-3 text-xs focus:ring-2 focus:ring-indigo-500 focus:outline-none">
                <button type="submit" class="bg-indigo-600 hover:bg-indigo-500 text-white font-medium px-5 py-3 rounded-xl text-xs transition shadow-md">Send</button>
            </form>
        </div>

        <div class="flex justify-between items-center pt-4">
            <a href="/dashboard" class="bg-slate-200 hover:bg-slate-300 text-slate-700 font-semibold px-4 py-2 rounded-xl text-xs transition">Back to Dashboard</a>
        </div>
    </main>

    <footer class="bg-white border-t border-slate-200 p-4 text-center text-xs text-slate-400">
        DannaEdu AI &copy; 2026
    </footer>

    <script>
        const chatForm = document.getElementById('chat-form');
        const chatInput = document.getElementById('chat-input');
        const chatBox = document.getElementById('chat-box');
        const courseId = "<%= course.id %>";

        chatForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const message = chatInput.value.trim();
            if (!message) return;

            // Display user message
            chatBox.innerHTML += `<div class="bg-slate-200 text-slate-800 p-3 rounded-xl self-end max-w-[80%]">${message}</div>`;
            chatInput.value = '';
            chatBox.scrollTop = chatBox.scrollHeight;

            try {
                const response = await fetch(`/courses/view/${courseId}/chat`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message })
                });
                const data = await response.json();

                if (data.reply) {
                    chatBox.innerHTML += `<div class="bg-indigo-50 text-indigo-900 p-3 rounded-xl self-start max-w-[80%] border border-indigo-100">${data.reply}</div>`;
                } else {
                    chatBox.innerHTML += `<div class="bg-red-50 text-red-600 p-3 rounded-xl self-start max-w-[80%]">Error receiving response from AI.</div>`;
                }
            } catch (err) {
                chatBox.innerHTML += `<div class="bg-red-50 text-red-600 p-3 rounded-xl self-start max-w-[80%]">Network error.</div>`;
            }
            chatBox.scrollTop = chatBox.scrollHeight;
        });
    </script>
</body>
</html>